<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX 清单：提交 Microsoft Store 用。
     Identity Name/Publisher 在合作伙伴中心创建应用后由商店分配，提交时替换。 -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">
  <Identity Name="EyeCare20"
            Publisher="CN=TODO-REPLACE-WITH-STORE-PUBLISHER-ID"
            Version="1.3.1.0"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>EyeCare20 护眼提醒</DisplayName>
    <PublisherDisplayName>songyun</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="zh-CN" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="EyeCare20" Executable="EyeCare20.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="EyeCare20 护眼提醒"
        Description="基于 20-20-20 法则的护眼提醒：望远、眨眼、久坐、喝水四类提醒，68KB 零依赖"
        BackgroundColor="#048A4A"
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="assets\Wide310x150Logo.png" Square310x310Logo="assets\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
